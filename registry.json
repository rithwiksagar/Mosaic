      "type": "registry:component",
      "dependencies": ["lucide-react", "motion"],
      "registryDependencies": ["utils"],
      "files": [
        {
          "path": "components/ui/textactions.tsx",
          "type": "registry:ui"
        }
      ]
    },
    {
      "name": "prompt-launcher",
      "description": "A compact prompt launcher that expands horizontally from a button into an AI input.",
      "type": "registry:component",
      "dependencies": ["lucide-react", "motion"],
      "registryDependencies": ["utils"],
      "files": [
        {
          "path": "components/ui/prompt-launcher.tsx",
          "type": "registry:ui"
        }
      ]
    },
    {
      "name": "prompt-trigger",
