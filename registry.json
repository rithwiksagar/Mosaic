{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "mosaic-ui",
  "homepage": "https://brainframeui.tech",
  "items": [
    {
      "name": "utils",
      "type": "registry:lib",
      "files": [
        {
          "path": "lib/utils.ts",
          "type": "registry:lib"
        }
      ]
    },
    {
      "name": "prompt-bar",
      "description": "A polished AI prompt input with slash commands for quickly switching between actions and tools.",
